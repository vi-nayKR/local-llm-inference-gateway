# ==============================================================================
# Local LLM Inference Gateway — Environment Configuration
# (All values are optional; the gateway works 100% offline out-of-the-box)
# ==============================================================================

# Redis 8 Vector Semantic Cache
REDIS_URL=redis://localhost:6379/0
CACHE_SIMILARITY_THRESHOLD=0.60
CACHE_TTL_SECONDS=86400

# Local Model (SLM) Settings
DEFAULT_MODEL=meta-llama/Llama-3.2-1B-Instruct
VLLM_API_BASE=http://localhost:8000/v1
OLLAMA_API_BASE=http://localhost:11434/v1

# Optional External Fallback API Keys (Plug in if you want cloud generation)
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
